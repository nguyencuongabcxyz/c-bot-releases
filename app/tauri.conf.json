{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "C-Bot",
  "version": "../package.json",
  "identifier": "com.cbot.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "bun run dev",
    "beforeBuildCommand": "bun run build"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico", "icons/icon.png"],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDlBRDA1REVBM0RDMjAyNDYKUldSR0FzSTk2bDNRbW5xTXZ4eFRjTlNENFJCL04xTzFPb2xzRWFUUHBWUjJZbG1xZ084ZkZ2WlYK",
      "endpoints": ["https://github.com/nguyencuongabcxyz/c-bot-releases/releases/latest/download/latest.json"],
      "windows": {
        "installMode": "quiet"
      }
    }
  }
}
