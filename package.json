{
  "name": "c-bot",
  "version": "2.0.1",
  "description": "Cartoon desktop robots that are secretly Claude Code",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc -p . && tsc -p tsconfig.node.json",
    "format": "prettier --write \"gui/**/*.ts\" vite.config.ts vitest.config.ts",
    "lint": "biome lint --error-on-warnings",
    "check": "biome check --error-on-warnings && prettier --check \"gui/**/*.ts\" vite.config.ts vitest.config.ts",
    "test": "vitest run",
    "start": "tauri dev",
    "dist": "tauri build",
    "tauri": "tauri"
  },
  "license": "MIT",
  "private": true,
  "dependencies": {
    "@tauri-apps/api": "2.12.4",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-web-links": "0.12.0",
    "@xterm/xterm": "6.0.0",
    "dompurify": "3.4.17",
    "highlight.js": "11.12.0",
    "marked": "18.1.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "@tauri-apps/cli": "^2.12.4",
    "@types/node": "^26.6.5",
    "@types/three": "^0.187.0",
    "happy-dom": "^21.0.4",
    "jsdom": "30.1.3",
    "prettier": "^3.9.10",
    "three": "^0.187.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
